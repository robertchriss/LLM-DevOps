# Copy to /etc/llm-devops-agent.env and chmod 600 it.
# Replace the token with a long random value; never commit the real file.
LLM_DEVOPS_API_TOKEN=replace-with-a-long-random-secret
LLM_DEVOPS_WORKSPACE=/opt/LLM-DevOps
PROJECT_WORKSPACE=/opt/LLM-DevOps
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_FAST_MODEL=qwen2.5:7b
OLLAMA_WORKER_MODELS=qwen2.5:14b,deepseek-r1:14b
OLLAMA_JUDGE_MODEL=qwen2.5:32b
USE_JUDGE=true
LLM_DEVOPS_TASK_DB=/var/lib/llm-devops/tasks.sqlite3
LLM_DEVOPS_WORKTREE_ROOT=/opt/LLM-DevOps-agent-worktrees
LLM_DEVOPS_TASK_WORKERS=2
HARNESS_QUEUE_LIMIT=8
LLM_DEVOPS_PR_MONITOR=true
LLM_DEVOPS_PR_POLL_SECONDS=90
LLM_DEVOPS_MAX_REVIEW_CYCLES=3
