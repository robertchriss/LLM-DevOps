# Copy to .env locally; do not commit real secrets.
OLLAMA_BASE_URL=http://localhost:11434
LLM_DEVOPS_SMALL_MODEL_A=ollama/qwen2.5:14b
LLM_DEVOPS_SMALL_MODEL_B=ollama/deepseek-r1:14b
LLM_DEVOPS_JUDGE_MODEL=ollama/qwen2.5:32b
LLM_DEVOPS_WORKSPACE=.
LLM_DEVOPS_MODEL_TIMEOUT=240
LLM_DEVOPS_MAX_REPAIRS=2
LLM_DEVOPS_MAX_OUTPUT_BYTES=1000000
LLM_DEVOPS_API_TOKEN=
LLM_DEVOPS_BRIDGE_PORT=8000
LLM_DEVOPS_MAX_PROMPT_CHARS=30000
LLM_DEVOPS_MAX_FILE_BYTES=1000000
LLM_DEVOPS_MAX_PARALLEL_MODEL_CALLS=3

# Development PostgreSQL settings. Use a unique local password.
PGUSER=llm_devops
PGPASSWORD=Password123!
PGDATABASE=k8s_quiz
PGPORT=5432
PORT=5000
