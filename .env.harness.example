PROJECT_WORKSPACE=.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_FAST_MODEL=qwen2.5:7b
OLLAMA_WORKER_MODELS=qwen2.5:14b,deepseek-r1:14b
OLLAMA_JUDGE_MODEL=qwen2.5:32b
USE_JUDGE=true
HARNESS_MAX_ITERATIONS=3
HARNESS_MAX_TASKS=12
HARNESS_COMMAND_TIMEOUT=120
HARNESS_MODEL_TIMEOUT=180
HARNESS_QUEUE_LIMIT=8
LLM_DEVOPS_TASK_WORKERS=2
LLM_DEVOPS_TASK_DB=.llm_devops_tasks.sqlite3
LLM_DEVOPS_WORKTREE_ROOT=../LLM-DevOps-agent-worktrees
LLM_DEVOPS_PR_MONITOR=true
LLM_DEVOPS_PR_POLL_SECONDS=90
LLM_DEVOPS_MAX_REVIEW_CYCLES=3
